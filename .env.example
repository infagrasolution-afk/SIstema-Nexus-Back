# ─────────────────────────────────────────────────────────────────────────────
# APEX ERP — Variables de entorno (copia este archivo como ".env" para trabajar local)
# En Render: Dashboard → erp-backend → Environment → agrega cada variable.
# NUNCA subas el archivo .env real a GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# URL de PostgreSQL (Neon / Render / Azure). Obligatoria.
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST/BASEDEDATOS

# Clave para firmar las sesiones. Mínimo 32 caracteres aleatorios. Obligatoria en producción.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Dominios autorizados a usar la API (separados por coma, sin "/" al final)
ALLOWED_ORIGINS=https://erp-frontend-8hz1.onrender.com,http://localhost:5173

# production | development
ENVIRONMENT=development

# Mostrar documentación interactiva en /docs (true solo en desarrollo)
ENABLE_DOCS=true

# Opcionales (valores por defecto entre paréntesis)
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
# MAX_LOGIN_ATTEMPTS=3
# LOCKOUT_MINUTES=15
# LOGIN_RATE_LIMIT=10
# GLOBAL_RATE_LIMIT=600
